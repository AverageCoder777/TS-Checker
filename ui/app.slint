import { VerticalBox, HorizontalBox, Button, LineEdit, ListView, CheckBox, StandardTableView, Slider, TextEdit, ComboBox } from "std-widgets.slint";

export struct RouteItem {
    name: string,
    icon-source: image,
}

export struct ScenarioItem {
    name: string,
    scenario-type: string,
}

export component MainWindow inherits Window {
    title: "TS-Checker";
    min-width: 1350px;
    min-height: 1000px;

    in property <[RouteItem]> route-items: [];
    in-out property <bool> route-thumbnails-enabled: true;
    in-out property <bool> ignore-list-open: false;
    in property <[string]> ignored-routes: [];
    in property <[string]> incomplete-folders: [];
    in property <string> check-log: "";

    in property <float> check_progress: 0.0;
    in property <string> status: "";
    in-out property <string> search-query: "";
    in-out property <int> selected-route: -1;
    in property <bool> is-checking: false;
    in-out property <bool> show_log: false;
    in property <int> missing-assets-count: 0;
    in property <string> selected-route-name: "";
    in property <string> selected-route-id: "";
    in property <[ScenarioItem]> scenario-items: [];
    in-out property <int> selected-scenario: -1;
    in property <bool> has-result: false;

    callback route-selected(int);
    callback start-check();
    callback reset-log();
    callback open-route-folder();
    callback show-inventory();
    callback open-settings();
    callback scenario-selected(int);

    HorizontalLayout {
        // Left master: compact route list
        VerticalBox {
            preferred-width: 380px;
            min-width: 380px;
            max-width: 380px;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "Поиск маршрутов...";
                    text <=> search-query;
                }
                Button {
                    text: "⚙";
                    min-width: 32px;
                    clicked => { open-settings(); }
                }
            }
            ListView {
                vertical-stretch: 1;
                for item[i] in route-items: Rectangle {
                    min-height: 52px;
                    preferred-height: 56px;
                    background: i == selected-route ? #3a3a3a : transparent;
                    TouchArea {
                        clicked => {
                            selected-route = i;
                            route-selected(i);
                        }
                        double-clicked => {
                            open-route-folder();
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: LayoutAlignment.start;
                            padding: 4px;
                            Image {
                                source: item.icon-source;
                                width: route-thumbnails-enabled ? 64px : 0px;
                                height: route-thumbnails-enabled ? 40px : 0px;
                                preferred-width: route-thumbnails-enabled ? 64px : 0px;
                                preferred-height: route-thumbnails-enabled ? 40px : 0px;
                            }
                            Text {
                                text: item.name;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }
        // Right detail
        VerticalBox {
            horizontal-stretch: 1;
            padding: 8px;
            spacing: 6px;
            if selected-route >= 0 : HorizontalLayout {
                spacing: 12px;
                alignment: LayoutAlignment.start;
                Rectangle {
                    width: 200px;
                    height: 100px;
                    horizontal-stretch: 0;
                    border-radius: 6px;
                    clip: true;
                    background: transparent;
                    Image {
                        source: route-items[selected-route].icon-source;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
                VerticalBox {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: 4px;
                    Text {
                        text: selected-route-name;
                        font-size: 18px;
                        font-weight: 700;
                        wrap: TextWrap.no-wrap;
                        overflow: TextOverflow.elide;
                    }
                    Text {
                        text: "GUID: " + selected-route-id;
                        font-size: 12px;
                        color: #999999;
                        wrap: TextWrap.no-wrap;
                        overflow: TextOverflow.elide;
                    }
                    Text {
                        text: "Сценариев: \{scenario-items.length}";
                        font-size: 13px;
                        color: #cccccc;
                    }
                }
            }
            Rectangle { height: 16px; }
            Text { text: "Сценарии маршрута:"; font-size: 14px; }
            HorizontalBox {
                min-height: 32px;
                preferred-height: 32px;
                padding-top: 4px;
                Text {
                    text: "Название сценария";
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Тип";
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 130px;
                    horizontal-alignment: TextHorizontalAlignment.right;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-height: 120px;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                ListView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    for s[i] in scenario-items: Rectangle {
                    background: i == selected-scenario ? #3a3a3a : (Math.mod(i, 2) == 0 ? #1f1f1f : #262626);
                    TouchArea {
                        clicked => {
                            selected-scenario = i;
                        }
                        double-clicked => {
                            scenario-selected(i);
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: LayoutAlignment.stretch;
                            padding: 2px;
                            Text {
                                text: s.name;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                            Text {
                                text: s.scenario-type;
                                font-size: 14px;
                                vertical-alignment: center;
                                width: 130px;
                                horizontal-alignment: TextHorizontalAlignment.right;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
                }
            }
            HorizontalBox {
                min-height: 30px;
                preferred-height: 40px;
                Rectangle {
                    min-height: 30px;
                    preferred-height: 32px;
                    horizontal-stretch: 0;
                    border-radius: 4px;
                    background: route_check_touch.pressed ? #047857 : (route_check_touch.has-hover ? #10b981 : #059669);
                    route_check_touch := TouchArea {
                        enabled: selected-route >= 0;
                        clicked => { show_log = true; start-check(); }
                    }
                    Text {
                        text: "Проверить маршрут";
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Button {
                    min-height: 30px;
                    text: "Показать все объекты";
                    enabled: has-result;
                    clicked => { show-inventory(); }
                }
                Button {
                    min-height: 30px;
                    text: show_log ? "Скрыть лог" : "Показать лог";
                    clicked => { show_log = !show_log; }
                }
            }
            if show_log : Rectangle {
                height: 160px;
                width: 100%;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #1a1a1a;
                clip: true;
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        preferred-height: 24px;
                        min-height: 24px;
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "Лог";
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: #aaaaaa;
                        }
                        /*Button {
                            text: "X";
                            min-width: 24px;
                            clicked => { show_log = false; }
                        }*/
                    }
                    log_view := TextEdit {
                        text: check-log;
                        edited => { reset-log(); }
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                    }
                }
            }
            Text {
                text: status;
                font-size: 13px;
                color: missing-assets-count > 0 ? #ef4444 : #22c55e;
            }
        }
    }
}

export component AssetInventoryWindow inherits Window {
    title: "Инвентарь ассетов маршрута";
    min-width: 900px;
    min-height: 700px;

    in property <[ [StandardListViewItem] ]> inventory-rows;
    in property <[bool]> inventory-is-safe: [];
    in property <bool> show-missing-only: false;
    in-out property <string> search-query: "";
    in-out property <int> current-row: -1;
    in-out property <int> selected-asset: -1;

    callback toggle-missing-only();
    callback search-changed(string);
    callback row-selected(int);
    callback open-in-editor();
    callback replace-inventory-asset(int);
    callback scan-umlauts();
    callback sort-ascending(int);
    callback sort-descending(int);

    VerticalBox {
        HorizontalBox {
            LineEdit {
                placeholder-text: "Поиск по пути, тайлу или исходному файлу";
                text <=> search-query;
                edited(text) => { root.search-changed(text); }
            }
            Button {
                text: show-missing-only ? "Показать все" : "Только недостающие";
                clicked => { toggle-missing-only(); }
            }
            Button {
                text: "Открыть в редакторе";
                clicked => { root.open-in-editor(); }
            }
            Rectangle {
                property <bool> can_replace: selected-asset >= 0 && selected-asset < inventory-is-safe.length && inventory-is-safe[selected-asset];
                min-width: 190px;
                preferred-height: 32px;
                border-radius: 4px;
                background: !can_replace ? #262626 : (replace_touch.pressed ? #047857 : (replace_touch.has-hover ? #10b981 : #059669));

                replace_touch := TouchArea {
                    enabled: can_replace;
                    clicked => { root.replace-inventory-asset(selected-asset); }
                }

                Text {
                    text: "Заменить в маршруте...";
                    color: !can_replace ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: "Проверить на умляуты";
                clicked => { root.scan-umlauts(); }
            }
        }
        if selected-asset >= 0 && selected-asset < inventory-is-safe.length && !inventory-is-safe[selected-asset] : Text {
            text: "⚠ Путевые объекты и сигналы (Tracks.bin) заменяются только в редакторе TSC во избежание сбоя линков.";
            color: #f59e0b;
            font-size: 12px;
        }
        StandardTableView {
            current-row-changed(row) => {
                root.row-selected(row);
            }
            columns: [
                { title: "Путь ассета", min-width: 200px, horizontal-stretch: 2, sort-order: SortOrder.ascending },
                { title: "Кол-во использований", min-width: 120px, horizontal-stretch: 0 },
                { title: "Тайлы", min-width: 120px, horizontal-stretch: 1 },
            ];
            rows: inventory-rows;
            current-row <=> current-row;
            sort-ascending(col) => { root.sort-ascending(col); }
            sort-descending(col) => { root.sort-descending(col); }
        }
    }
}

export component IgnoreListWindow inherits Window {
    title: "Игнор-лист маршрутов";
    min-width: 400px;
    min-height: 300px;

    in property <[string]> ignored-routes;

    VerticalBox {
        ListView {
            for r in ignored-routes: Text { text: r; }
        }
        Button { text: "Добавить выбранный маршрут в игнор-лист"; }
    }
}

export component IncompleteFoldersWindow inherits Window {
    title: "Неполные папки";
    min-width: 500px;
    min-height: 300px;

    in property <[string]> folders;

    VerticalBox {
        ListView {
            for f in folders: Text { text: f; }
        }
    }
}

export component ScenarioWindow inherits Window {
    title: scenario-title;
    min-width: 1150px;
    min-height: 560px;

    in property <string> scenario-title: "";
    in property <string> scenario-name: "";
    in property <string> scenario-author: "";
    in property <string> scenario-season: "";
    in property <string> scenario-start-time: "";
    in property <string> scenario-weather: "";
    in property <[string]> consist-names: [];
    in property <[bool]> consist-player: [];
    accessible-role: AccessibleRole.none;
    in property <[bool]> consist-missing: [];
    in property <[bool]> consist-complete: [];
    in property <[string]> vehicle-names: [];
    in property <[bool]> vehicle-missing: [];
    in property <[string]> vehicle-paths: [];
    in property <string> selected-vehicle-path: "";
    in property <string> selected-vehicle-info: "";
    in property <image> selected-vehicle-image;

    in-out property <int> selected-consist: -1;
    in-out property <int> selected-vehicle: -1;

    callback consist-selected(int);
    callback open-locoswap();
    callback open-locoswap-consist(int);
    callback open-vehicle-path(int);
    callback vehicle-selected(int);
    callback open-selected-vehicle-path();
    callback open-scenario-folder();
    callback close-scenario();

    VerticalBox {
        padding: 8px;
        spacing: 8px;
        Rectangle {
            background: #1e1e1e;
            border-radius: 6px;
            VerticalBox {
                padding: 8px;
                spacing: 4px;
                Text { text: scenario-name; font-size: 16px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: "Время: " + scenario-start-time; font-size: 12px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: "Автор: " + scenario-author; font-size: 12px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: "Погода: " + scenario-weather; font-size: 12px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        background: #22252a;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            Text { text: "Сезон: " + scenario-season; font-size: 12px; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        HorizontalBox {
            spacing: 6px;
            vertical-stretch: 1;
            Rectangle {
                min-width: 295px;
                max-width: 295px;
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                VerticalBox {
                    padding: 6px;
                    spacing: 4px;
                    Text { text: "Составы (" + consist-names.length + ")"; font-size: 14px; font-weight: 600; color: #cccccc; }
                    ListView {
                        vertical-stretch: 1;
                        for c[i] in consist-names: Rectangle {
                            background: i == selected-consist ? #3a3a3a : transparent;
                            TouchArea {
                                clicked => {
                                    selected-consist = i;
                                    consist-selected(i);
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: LayoutAlignment.start;
                                    padding: 2px;
                                    Text {
                                        text: "●";
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        color: consist-complete[i] ? #10b981 : #ef4444;
                                    }
                                    if consist-player[i] : Rectangle {
                                        width: 42px;
                                        height: 16px;
                                        background: #1e3a5f;
                                        border-radius: 3px;
                                        Text {
                                            text: "Игрок";
                                            color: #93c5fd;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: c;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: #e5e5e5;
                                        horizontal-stretch: 1;
                                        wrap: TextWrap.no-wrap;
                                        overflow: TextOverflow.elide;
                                    }
                                    if consist-missing[i] : Button {
                                        text: "LocoSwap";
                                        clicked => { open-locoswap-consist(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                min-width: 295px;
                max-width: 295px;
                horizontal-stretch: 0;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                VerticalBox {
                    padding: 6px;
                    spacing: 4px;
                    Text { text: "Подвижные единицы (" + vehicle-names.length + ")"; font-size: 14px; font-weight: 600; color: #cccccc; }
                    ListView {
                        vertical-stretch: 1;
                        for v[i] in vehicle-names: Rectangle {
                            background: i == selected-vehicle ? #3a3a3a : transparent;
                            TouchArea {
                                clicked => {
                                    selected-vehicle = i;
                                    vehicle-selected(i);
                                }
                                double-clicked => { open-vehicle-path(i); }
                                HorizontalLayout {
                                    padding: 2px;
                                    Text {
                                        text: v;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: vehicle-missing[i] ? #ff6666 : #dddddd;
                                        horizontal-stretch: 1;
                                        wrap: TextWrap.no-wrap;
                                        overflow: TextOverflow.elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                border-width: 1px;
                border-color: #444444;
                border-radius: 4px;
                background: #181818;
                clip: true;
                VerticalLayout {
                    alignment: LayoutAlignment.start;
                    spacing: 6px;
                    padding: 6px;
                    Text { text: "Свойства единицы"; font-size: 14px; font-weight: 600; color: #cccccc; }
                    Text {
                        text: selected-vehicle-info;
                        font-size: 12px;
                        wrap: TextWrap.word-wrap;
                        vertical-alignment: top;
                    }
                    TouchArea {
                        height: 18px;
                        double-clicked => { open-selected-vehicle-path(); }
                        HorizontalLayout {
                            alignment: LayoutAlignment.start;
                            padding: 0;
                            Text {
                                text: selected-vehicle-path;
                                font-size: 11px;
                                color: #4da3ff;
                                horizontal-alignment: TextHorizontalAlignment.left;
                                vertical-alignment: TextVerticalAlignment.center;
                                wrap: TextWrap.no-wrap;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                    if selected-vehicle-image.width > 0 : HorizontalLayout {
                        alignment: LayoutAlignment.start;
                        padding-top: 4px;
                        Rectangle {
                            width: 256px;
                            height: 128px;
                            border-radius: 4px;
                            clip: true;
                            background: #111111;
                            Image {
                                source: selected-vehicle-image;
                                width: 256px;
                                height: 128px;
                                image-fit: contain;
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
            }
        }
        HorizontalBox {
            min-height: 36px;
            preferred-height: 40px;
            padding: 4px;
            Button {
                text: "Открыть папку";
                clicked => { open-scenario-folder(); }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Rectangle {
                min-width: 200px;
                preferred-width: 200px;
                preferred-height: 32px;
                border-radius: 4px;
                background: locoswap_touch.pressed ? #047857 : (locoswap_touch.has-hover ? #10b981 : #059669);
                locoswap_touch := TouchArea {
                    clicked => { open-locoswap(); }
                }
                Text {
                    text: "Открыть в LocoSwap";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: "Закрыть";
                clicked => { close-scenario(); }
            }
        }
    }
}
export component MissingAssetsWindow inherits Window {
    title: "Недостающие ассеты";
    min-width: 700px;
    min-height: 400px;

    in property <[string]> missing-assets: [];
    in property <[int]> missing-counts: [];
    in property <[string]> missing-suggested-repairs: [];
    in property <[bool]> missing-corrupted: [];
    in-out property <[string]> active-tile-list: [];
    in property <string> active-tile-asset: "";
    in-out property <int> selected-asset: -1;
    callback replace-missing(int);
    callback repair-corrupted(int);
    callback repair-all-corrupted();
    callback copy-to-clipboard(string);
    callback copy-all-to-clipboard();
    callback close-missing();
    callback inspect-tiles(int);

    VerticalBox {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Недостающие ассеты маршрута";
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                background: #3b1d24;
                border-radius: 4px;
                min-width: 26px;
                height: 22px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: missing-assets.length;
                        color: #f87171;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            background: #181818;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            clip: true;
            vertical-stretch: 1;
            ListView {
                for asset[i] in missing-assets: Rectangle {
                    background: i == selected-asset ? #2c2d30 : (row_touch.has-hover ? #222326 : transparent);
                    border-radius: 3px;

                    row_touch := TouchArea {
                        clicked => { selected-asset = i; }
                        double-clicked => { replace-missing(i); }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 8px;
                        padding-right: 6px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: asset;
                            font-size: 12px;
                            color: #e2e8f0;
                            vertical-alignment: TextVerticalAlignment.center;
                            horizontal-alignment: TextHorizontalAlignment.left;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            overflow: TextOverflow.elide;
                        }

                        if missing-corrupted[i] : Rectangle {
                            background: #d97706;
                            border-radius: 3px;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "Повреждён путь";
                                    color: #ffffff;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            background: #25282e;
                            border-radius: 3px;
                            height: 22px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "×" + missing-counts[i];
                                    font-size: 11px;
                                    color: #94a3b8;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if missing-corrupted[i] && missing-suggested-repairs[i] != "" : Text {
                            text: "-> " + missing-suggested-repairs[i];
                            font-size: 11px;
                            color: #fbbf24;
                            vertical-alignment: center;
                            overflow: TextOverflow.elide;
                        }

                        Button {
                            text: "📋";
                            horizontal-stretch: 0;
                            min-width: 32px;
                            preferred-height: 24px;
                            clicked => { copy-to-clipboard(asset); }
                        }

                        if missing-corrupted[i] : Button {
                            text: "Починить";
                            min-width: 70px;
                            preferred-height: 24px;
                            clicked => { repair-corrupted(i); }
                        }

                        Button {
                            text: "Тайлы";
                            min-width: 60px;
                            preferred-height: 24px;
                            clicked => { inspect-tiles(i); }
                        }
                    }
                }
            }
        }
        if active-tile-list.length > 0 : Rectangle {
            background: #141414;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            preferred-height: 140px;
            max-height: 160px;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                HorizontalLayout {
                    Text {
                        text: "Использование на тайлах для: " + active-tile-asset;
                        font-size: 12px;
                        font-weight: 700;
                        color: #cbd5e1;
                        horizontal-stretch: 1;
                        overflow: TextOverflow.elide;
                    }
                    Button {
                        text: "✕ Закрыть";
                        preferred-height: 20px;
                        clicked => { active-tile-list = []; }
                    }
                }
                ListView {
                    for tile in active-tile-list: HorizontalLayout {
                        padding: 2px;
                        Text {
                            text: tile;
                            font-size: 11px;
                            color: #94a3b8;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "📋";
                            min-width: 28px;
                            preferred-height: 20px;
                            clicked => { copy-to-clipboard(tile); }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;
            Button {
                text: "Скопировать весь список";
                clicked => { copy-all-to-clipboard(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                min-width: 210px;
                preferred-width: 210px;
                preferred-height: 32px;
                border-radius: 4px;
                background: repair_all_touch.pressed ? #047857 : (repair_all_touch.has-hover ? #10b981 : #059669);
                repair_all_touch := TouchArea {
                    clicked => { repair-all-corrupted(); }
                }
                Text {
                    text: "Починить все битые пути";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                min-width: 190px;
                preferred-width: 190px;
                preferred-height: 32px;
                border-radius: 4px;
                background: selected-asset < 0 ? #262626 : (replace_touch.pressed ? #047857 : (replace_touch.has-hover ? #10b981 : #059669));

                replace_touch := TouchArea {
                    enabled: selected-asset >= 0;
                    clicked => {
                        if (selected-asset >= 0) {
                            replace-missing(selected-asset);
                        }
                    }
                }

                Text {
                    text: "Заменить выбранный...";
                    color: selected-asset < 0 ? #666666 : #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Button {
                text: "Закрыть";
                clicked => { close-missing(); }
            }
        }
    }
}

export component ApAssetPickerWindow inherits Window {
    title: "Выбор ассета из архива";
    min-width: 620px;
    min-height: 420px;

    in property <string> archive-name: "";
    in-out property <string> search-query: "";
    in property <[string]> entries: [];
    in property <[string]> filtered-entries: [];
    in-out property <int> selected-index: -1;

    callback search-changed(string);
    callback select-entry(int);
    callback confirm-selection();
    callback cancel();

    VerticalBox {
        padding: 6px;
        spacing: 6px;
        Text {
            text: "Выбор ассета из архива: " + archive-name;
            font-size: 16px;
            font-weight: 700;
        }
        LineEdit {
            placeholder-text: "Поиск...";
            text <=> search-query;
            edited => { search-changed(search-query); }
        }
        Rectangle {
            background: #181818;
            border-color: #333333;
            border-width: 1px;
            border-radius: 4px;
            clip: true;
            vertical-stretch: 1;
            ListView {
                for entry[i] in filtered-entries: Rectangle {
                    background: i == selected-index ? #2c2d30 : (row_touch.has-hover ? #222326 : transparent);
                    row_touch := TouchArea {
                        clicked => { select-entry(i); }
                        double-clicked => { select-entry(i); confirm-selection(); }
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 6px;
                            Text {
                                text: entry;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                overflow: TextOverflow.elide;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            min-height: 36px;
            padding: 4px;
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Отмена";
                clicked => { cancel(); }
            }
            Rectangle {
                min-width: 100px;
                preferred-width: 120px;
                preferred-height: 32px;
                border-radius: 4px;
                background: pick_touch.pressed ? #047857 : (pick_touch.has-hover ? #10b981 : #059669);
                pick_touch := TouchArea {
                    clicked => { confirm-selection(); }
                }
                Text {
                    text: "Выбрать";
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Настройки";
    min-width: 400px;
    min-height: 210px;

    in-out property <int> serz-process-limit: 8;
    in property <int> serz-process-limit-max: 16;
    in property <[string]> serz-presets: [];
    in-out property <int> serz-process-limit-index: 0;
    in-out property <string> locoswap-path: "";
    in-out property <string> game-path: "";
    max-height: 230px;
    max-width: 400px;
    preferred-height: 230px;
    preferred-width: 400px;
    in-out property <bool> route-thumbnails-enabled: true;
    in-out property <bool> route-scan-on-hdd: false;
    in-out property <bool> hide-quick-drive-free-roam: false;

    callback save-settings();
    callback pick-locoswap();
    callback pick-game();
    callback serz-preset-selected(int);

    VerticalBox {
        HorizontalBox {
            alignment: LayoutAlignment.start;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding: 0px;
            Text { horizontal-alignment: TextHorizontalAlignment.start;
                min-width: 0px;
                overflow: TextOverflow.elide;
                text: "Потоков процессора:";
                vertical-alignment: TextVerticalAlignment.center; }
            
            ComboBox {
                width: 100px;
                model: serz-presets;
                current-index <=> serz-process-limit-index;
                selected(text) => {
                    root.serz-preset-selected(self.current-index)
                }
            }
        }
        HorizontalBox {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            min-height: 20px;
            padding: 0px;
            spacing: 8px;
            Text { horizontal-alignment: TextHorizontalAlignment.start;
                line-height-factor: 0;
                min-height: 20px;
                overflow: TextOverflow.elide;
                text: "Путь к LocoSwap:";
                vertical-alignment: TextVerticalAlignment.center;
                wrap: TextWrap.word-wrap; }
            LineEdit {
                font-family: "";
                font-italic: false;
                font-size: 0px;
                horizontal-alignment: TextHorizontalAlignment.left;
                min-height: 20px; text <=> locoswap-path; }
            Button { icon-size: 15px;
                min-height: 20px;
                text: "Обзор..."; clicked => { pick-locoswap(); } }
        }
        HorizontalBox {
            alignment: LayoutAlignment.stretch;
            cross-axis-alignment: CrossAxisAlignment.center;
            min-height: 20px;
            padding: 0px;
            spacing: 8px;
            Text { horizontal-alignment: TextHorizontalAlignment.start;
                line-height-factor: 0;
                min-height: 20px;
                overflow: TextOverflow.elide;
                text: "Папка с игрой:";
                vertical-alignment: TextVerticalAlignment.center;
                wrap: TextWrap.word-wrap; }
            LineEdit {
                font-family: "";
                font-italic: false;
                font-size: 0px;
                horizontal-alignment: TextHorizontalAlignment.left;
                min-height: 20px; text <=> game-path; }
            Button { icon-size: 15px;
                min-height: 20px;
                text: "Обзор..."; clicked => { pick-game(); } }
        }
        CheckBox {
            min-height: 20px;
            text: "Миниатюры маршрутов";
            checked <=> route-thumbnails-enabled;
        }
        CheckBox {
            min-height: 20px;
            text: "Игра установлена на HDD";
            checked <=> route-scan-on-hdd;
        }
        CheckBox {
            min-height: 20px;
            text: "Не отображать Quick-Drive и Free-Roam сценарии";
            checked <=> hide-quick-drive-free-roam;
        }
        Button {
            min-height: 20px;
            text: "Сохранить";
            clicked => { save-settings(); }
        }
    }
}

export component AssetEditorWindow inherits Window {
    title: "Редактор BIN/GeoPcDx";
    min-width: 900px;
    maximized: false;
    min-height: 600px;

    accessible-role: AccessibleRole.none;
    always-on-top: false;
    default-font-family: @tr("");
    default-font-size: 16px;
    default-font-weight: 0;
    in-out property <string> editor-text: "";
    full-screen: false;
    in property <string> status: "";
    in property <bool> loading: false;

    callback save();
    callback search-changed(string);

    VerticalBox {
        HorizontalBox {
            LineEdit {
                placeholder-text: "Поиск...";
                edited(text) => { root.search-changed(text); }
            }
            Button {
                text: "Сохранить";
                enabled: !loading;
                clicked => { root.save(); }
            }
        }
        TextEdit {
            text <=> editor-text;
        }
        Text { text: status; }
    }
}
